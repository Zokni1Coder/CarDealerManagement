@model ResponseCustomer

@{
    Layout = null;
}

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <link rel="stylesheet" href="~/stylesheet.css" />
    <title></title>
</head>
<body>
    <div class="form-container" id="Reservation-form">
        <form asp-action="UpdateCustomer" asp-controller="Customer" method="post">
            <input type="hidden" value="@Model.customerId" name="id"/>
            <div class="form-row">
                <label for="firstName">First name:</label>
                <input type="text" value="@Model.firstName" class="form-field" name="firstName" id="firstName">
            </div>
            <div class="form-row">
                <label for="lastName">Last name:</label>
                <input type="text" value="@Model.lastName" class="form-field" name="lastName" id="lastName">
            </div>
            <div class="form-row">
                <label for="birthDate">Birth date:</label>
                <input type="date" asp-for="birthDate" class="form-field" id="birthDate">
            </div>
            <div class="form-row">
                <label for="address">Address:</label>
                <input type="text" value="@Model.address" class="form-field" name="address" id="address">
            </div>
            <div class="form-row">
                <label for="phoneNumber">Phone:</label>
                <input type="tel" value="@Model.phoneNumber" class="form-field" name="phoneNumber" id="phoneNumber">
            </div>
            <div class="form-row">
                <label for="email">Email:</label>
                <input type="email" value="@Model.email" class="form-field" name="email" id="email">
            </div>
            <div class="actions">
                <div class="actions-back">
                    <a asp-action="GetAllCustomer" asp-controller="Customer">Back</a>
                </div>
                <button type="submit" class="btn">Submit</button>
            </div>
        </form>
    </div>
</body>
</html>
