@using Entities.Enums.Extensions
@model IEnumerable<CarResponse>

@{
    SortingDirection ChangingSortingType()
    {
        SortingDirection type = (SortingDirection) ViewBag.sortingDirection;
        if (type == SortingDirection.ASC)
        {
            type = SortingDirection.DESC;
        }
        else
            type = SortingDirection.ASC;

        return type;
    }
}

<div class="container-title">
    <h1>All Cars</h1>
</div>
<div class="content">
    <div class="filter-container">
        <div class="title">
            Set your Filters
        </div>
        <form method="get" asp-controller="main" asp-action="index">
            <div class="filter-option-row">
                <label for="vehicleType">Vehicle Type:</label>
                <select name="vehicleType" class="filter-field">
                    <option value="@null">Choose</option>
                    @foreach (var type in ViewBag.vehicleTypes)
                    {
                        <option value="@type">@type</option>
                    }
                </select>
            </div>
            <div class="filter-option-row">
                <label for="fuelType">Fuel Type:</label>
                <select name="fuelType" class="filter-field">
                    <option value="@null">Choose</option>
                    @foreach (SelectListItem type in ViewBag.fuelTypes)
                    {
                        <option value="@type.Value">@type.Text</option>
                    }
                </select>
            </div>
            <div class="filter-option-row">
                <label for="transmissionType">Transmission Type:</label>
                <select name="transmissionType" id="transmissionType" class="filter-field">
                    <option value="@null">Choose</option>
                    @foreach (var type in ViewBag.transmissionTypes)
                    {
                        <option value="@type">@type</option>
                    }
                </select>
            </div>
            <div class="filter-option-row">
                <label for="from">KM:</label>
                <input type="text" name="km.@nameof(RangeFilter.From)" id="from" placeholder="From" class="filter-field">
                <input type="text" name="km.@nameof(RangeFilter.To)" placeholder="To" class="filter-field">
            </div>
            <div class="filter-option-row">
                <label for="price">Price:</label>
                <input type="text" name="price.@nameof(RangeFilter.From)" id="price" class="filter-field" placeholder="From ">
                <input type="text" name="price.@nameof(RangeFilter.To)" class="filter-field" placeholder="To">
            </div>
            <div class="filter-option-row">
                <label for="">Show reserved cars:</label>
                <input type="checkbox" name="showingReserved">
            </div>
            <div>
                <button class="submit-button">Apply</button>
            </div>
        </form>
    </div>
    <div class="list-container">
        <div class="actionsForTable">
            <div class="searching-options">
                <form method="get" asp-controller="Main" asp-action="Index">
                <label for="">Searching parameter:</label>
                    <select class="searching-field" name="searchingParameter">
                    <option value=@nameof(CarResponse.manufacturer)>Manufacturer</option>
                    <option value=@nameof(CarResponse.model)>Model</option>
                    <option value=@nameof(CarResponse.vehicleType)>Chassis Type</option>
                    <option value=@nameof(CarResponse.transmissionType)>Transmission Type</option>
                    <option value=@nameof(CarResponse.fuelType)>Fuel Type</option>
                </select>
                    <input type="search" class="searching-field" name="searchingValue" id="">
                <button id="search-submit-button">Search</button>
                </form>
            </div>
            <div class="actionButtons">
                <a asp-controller="Main" asp-action="AddNewCar" id="addLink">Add</a>
            </div>
        </div>
        <div class="table-container">
            <table class="table">
                <tr>
                    <th><a href="~/main/index?sortingProperty=@nameof(Car.manufacturer)&sortingDirection=@ChangingSortingType()">Manufacturer</a>&#8593;&#8595;</th>
                    <th><a href="~/main/index?sortingProperty=@nameof(Car.model)&sortingDirection=@ChangingSortingType()">Model&#8593;&#8595;</a></th>
                    <th><a href="~/main/index?sortingProperty=@nameof(Car.vehicleType)&sortingDirection=@ChangingSortingType()">Vehicle Type&#8593;&#8595;</a></th>
                    <th><a href="~/main/index?sortingProperty=@nameof(Car.transmissionType)&sortingDirection=@ChangingSortingType()">Transmission Type&#8593;&#8595;</a></th>
                    <th><a href="~/main/index?sortingProperty=@nameof(Car.fuelType)&sortingDirection=@ChangingSortingType()">Fuel Type&#8593;&#8595;</a></th>
                    <th><a href="~/main/index?sortingProperty=@nameof(Car.km)&sortingDirection=@ChangingSortingType()">KM&#8593;&#8595;</a></th>
                    <th><a href="~/main/index?sortingProperty=@nameof(Car.price)&sortingDirection=@ChangingSortingType()">Price&#8593;&#8595;</a></th>
                    <th><a href="">Reservation</a></th>
                    <th><a href="">Actions</a></th>
                </tr>
                @foreach (CarResponse car in Model)
                {
                    <tr>
                        <td>@car.manufacturer</td>
                        <td>@car.model</td>
                        <td>@car.vehicleType</td>
                        <td>@car.transmissionType</td>
                        <td>@car.fuelType.GetDisplayName()</td>
                        <td>@car.km</td>
                        <td>@car.price$</td>
                        <td>ads</td>
                        <td id="actions-cell">
                            <div class="table-action-buttons">
                                <form asp-controller="Main">
                                    <input value="@car.id" name="CarId" type="hidden" />
                                    <button>More details</button>
                                    <button formmethod="post" asp-action="SellCar">Sell</button>
                                    <button type="button" onclick="window.open('@Url.Action("AddNewReservation", "Main", new { carId = car.id })', '_blank', 'width=800,height=800')" formmethod="get">Reserving</button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </table>
        </div>
    </div>
</div> 