@model IEnumerable<CarResponse> 

<h1>Hello from Index view</h1>

<table>
    <thead>
        <tr>
            <td>Manufacturer</td>
            <td>Model</td>
            <td>KM</td>
            <td>HP</td>
        </tr>
    </thead>
    <tbody>
        @foreach (CarResponse car in Model)
        {
          <tr>
                <td>@car.manufacturer</td>
                <td>@car.model</td>
                <td>@car.km</td>
                <td>@car.hp</td>
          </tr>  
        }
    </tbody>
</table>