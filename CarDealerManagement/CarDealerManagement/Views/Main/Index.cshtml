@using Entities.Enums.Extensions
@model IEnumerable<CarResponse>

<div class="container-title">
    <h1>All Cars</h1>
</div>
<div class="actionsForTable">
    <div class="searching-options">
        <label for="">Searching parameter:</label>
        <select>
            <option value="Manufacturer">Manufacturer</option>
            <option value="Manufacturer">Model</option>
            <option value="Manufacturer">Chassis Type</option>
            <option value="Manufacturer">Transmission Type</option>
            <option value="Manufacturer">Fuel Type</option>
        </select>
        <input type="search" name="" id="">
        <button>Submit</button>
    </div>
    <div class="actionButtons">
        <a asp-controller="Main" asp-action="AddNewCar" id="addLink">Add</a>
    </div>
</div>
<div class="table-container">
    <table class="table">
        <tr>
            <th><a href="">Manufacturer</a> &#8593;&#8595;</th>
            <th><a href="">Model</a></th>
            <th><a href="">Vehicle Type</a></th>
            <th><a href="">Transmission Type</a></th>
            <th><a href="">Fuel Type</a></th>
            <th><a href="">KM</a></th>
            <th><a href="">Price</a></th>
            <th><a href="">Reservation</a></th>
            <th><a href="">Actions</a></th>
        </tr>
        @foreach (CarResponse car in Model)
        {            
            <tr>
                <td>@car.manufacturer</td>
                <td>@car.model</td>
                <td>@car.vehicleType</td>
                <td>@car.transmissionType</td>
                <td>@car.fuelType.GetDisplayName()</td>
                <td>@car.km</td>
                <td>@car.price</td>
                <td>ads</td>
                <td id="actions-cell">
                    <div class="table-action-buttons">
                        <form asp-controller="Main">
                            <input value="@car.id" name="id" type="hidden" />
                            <button>More details</button>
                            <button formmethod="post" asp-action="SellCar">Sell</button>
                            <button>Reserving</button>
                        </form>
                    </div>
                </td>
            </tr>
        }
    </table>
</div>    