@model CarResponse

@{
    Layout = null;

    decimal payingAmount = @Model.price / 10;
}
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <link rel="stylesheet" href="~/stylesheet.css" />
    <title>@ViewBag.Title</title>
</head>
<body>
    <div class="form-container" id="Reservation-form">
        <form action="" method="post">
            <div class="form-row">
                <label>Selected car:</label>
            </div>
            <div class="detail-form-row">
                <label>Manufacturer: @Model.manufacturer</label>
                <label>Model: @Model.model</label>
                <label>Manufacturin date: @Model.manufacturingDate.ToString("dd/MM/yyyy")</label>
                <label>Vehicle type: @Model.vehicleType</label>
                <label>Fuel type: @Model.fuelType</label>
                <label>Transmission: @Model.transmissionType</label>
                <label>KM: @Model.km</label>
                <label>HP: @Model.hp</label>
                <label>Price: @Model.price</label>
            </div>
            <div class="form-row">
                <label for="Pay_Amount">Reservation Pay Amount:</label>
                <input type="text" value="@payingAmount€" class="form-field" name="" id="Pay_Amount">
            </div>
            <div class="customer-form-row">
                <label>Customer:</label>
                <div class="customer-actions">                    
                    <a asp-controller="Customer" asp-action="GetAllCustomer" onclick="window.open(this.href, '_blank', 'width=1200,height=800'); return false;">Select</a>
                    <input type="hidden" id="customerId" name="customerId" />                    
                </div>
            </div>
            <div class="detail-form-row">
                <label>Full name: <span id="full-name"></span></label>
                <label>Birth date: <span id="birth-date"></span></label>
                <label>Address: <span id="address"></span></label>
                <label>Phone: <span id="phone"></span></label>
                <label>Email: <span id="email"></span></label>
            </div>
            <div class="actions">
                <div class="actions-back">
                    <a href="javascript:window.close();">Back</a>
                </div>
                <button type="submit" class="btn">
                    Submit
                </button>
            </div>
        </form>
    </div>
</body>
</html>
