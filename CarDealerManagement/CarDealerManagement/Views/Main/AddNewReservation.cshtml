@model CarResponse

@{
    Layout = null;
}
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <link rel="stylesheet" href="~/stylesheet.css" />
    <title>@ViewBag.Title</title>
</head>
<body>
    <div class="form-container" id="Reservation-form">
        <form action="" method="post">
            <div class="form-row">
                <label for="Selected_car">Selected car:</label>
                <input value="@Model.ToString()" type="text" disabled name="" class="form-field" id="Selected_car">
            </div>
            <div class="form-row">
                <label for="Pay_Amount">Reservation Pay Amount:</label>
                <input type="text" class="form-field" name="" id="Pay_Amount">
            </div>
            <div class="customer-form-row">
                <label for="Customer">Customer:</label>
                <div class="customer-actions">
                    <a href="/">Add new</a>
                    <a href="/">Select</a>
                </div>
            </div>
            <div class="form-row" id="customer-details">
                <label for="Pay_Amount">Full name: </label>
                <label for="Pay_Amount">Birth date: </label>
                <label for="Pay_Amount">Address:</label>
                <label for="Pay_Amount">Phone:</label>
                <label for="Pay_Amount">Email:</label>
            </div>
            <div class="actions">
                <div class="actions-back">
                    <a href="/">Back</a>
                </div>
                <input type="submit" class="btn" value="Submit">
            </div>
        </form>
    </div>
</body>
</html>
